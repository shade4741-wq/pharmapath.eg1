<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PharmaPath - منصة التوظيف والمسار المهني للصيدلي</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        @media print {
            body * { visibility: hidden; }
            #cv-preview-card, #cv-preview-card * { visibility: visible; }
            #cv-preview-card { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center space-x-3 space-x-reverse cursor-pointer" onclick="switchMainRole('pharmacist')">
                    <div class="w-10 h-10 bg-teal-500 rounded-xl flex items-center justify-center font-bold text-slate-900 text-xl shadow-lg shadow-teal-500/20">
                        <i class="fa-solid fa-pills"></i>
                    </div>
                    <div>
                        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-l from-teal-400 to-emerald-200 bg-clip-text text-transparent">PharmaPath</span>
                        <span class="text-[10px] block text-slate-400 -mt-1 font-semibold">دليلك المهني الصيدلي</span>
                    </div>
                </div>

                <!-- Navigation Tabs (Pharmacist Mode) -->
                <nav id="pharmacist-nav" class="hidden md:flex space-x-1 space-x-reverse text-sm font-medium">
                    <button onclick="switchTab('jobs')" class="nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-teal-400 font-bold" data-tab="jobs">
                        <i class="fa-solid fa-briefcase ml-1.5"></i>الوظائف
                    </button>
                    <button onclick="switchTab('paths')" class="nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-slate-300" data-tab="paths">
                        <i class="fa-solid fa-route ml-1.5"></i>المسارات المهنية
                    </button>
                    <button onclick="switchTab('cv')" class="nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-slate-300" data-tab="cv">
                        <i class="fa-solid fa-file-invoice ml-1.5"></i>منشئ الـ CV
                    </button>
                    <button onclick="switchTab('applications')" class="nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-slate-300 relative" data-tab="applications">
                        <i class="fa-solid fa-paper-plane ml-1.5"></i>طلباتي
                        <span id="app-badge" class="bg-teal-500 text-slate-900 text-[10px] font-bold px-1.5 py-0.5 rounded-full mr-1 hidden">0</span>
                    </button>
                </nav>

                <!-- Navigation Tabs (Employer Mode) -->
                <nav id="employer-nav" class="hidden md:flex space-x-1 space-x-reverse text-sm font-medium">
                    <button onclick="switchTab('emp-dashboard')" class="emp-nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-teal-400 font-bold" data-tab="emp-dashboard">
                        <i class="fa-solid fa-chart-line ml-1.5"></i>لوحة التحكم
                    </button>
                    <button onclick="switchTab('post-job')" class="emp-nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-slate-300" data-tab="post-job">
                        <i class="fa-solid fa-plus-circle ml-1.5"></i>نشر وظيفة
                    </button>
                    <button onclick="switchTab('candidates')" class="emp-nav-btn px-3 py-2 rounded-lg transition hover:bg-slate-800 text-slate-300" data-tab="candidates">
                        <i class="fa-solid fa-users-viewfinder ml-1.5"></i>البحث عن صيادلة
                    </button>
                </nav>

                <!-- Role Switcher Button -->
                <div class="flex items-center space-x-3 space-x-reverse">
                    <button id="role-toggle-btn" onclick="toggleMainRole()" class="text-xs bg-slate-800 hover:bg-slate-700 text-teal-300 font-semibold px-3 py-2 rounded-lg border border-slate-700 transition flex items-center">
                        <i class="fa-solid fa-building-user ml-1.5 text-teal-400"></i>
                        <span id="role-btn-text">حساب الشركات والصيدليات</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">

        <!-- ================= PHARMACIST VIEW ================= -->

        <!-- TAB 1: JOBS & FEED -->
        <div id="tab-jobs" class="tab-content active space-y-6">
            <!-- Hero Search Header -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-teal-950 text-white rounded-2xl p-6 md:p-8 shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <span class="inline-block px-3 py-1 bg-teal-500/20 text-teal-300 border border-teal-500/30 rounded-full text-xs font-semibold mb-3">PharmaPath Opportunities</span>
                    <h1 class="text-2xl md:text-4xl font-extrabold mb-2">اعثر على خطوتك القادمة في عالم الصيدلة</h1>
                    <p class="text-slate-300 text-sm md:text-base mb-6">آلاف الفرص الوظيفية المخصصة للصيادلة في مصر في مختلف التخصصات والقطاعات.</p>
                    
                    <!-- Search Bar -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-2 bg-white/10 p-2 rounded-xl backdrop-blur-md border border-white/10">
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute right-3 top-3.5 text-slate-400"></i>
                            <input type="text" id="search-title" placeholder="المسمى الوظيفي أو المهارة..." class="w-full bg-white text-slate-800 pr-9 pl-3 py-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div class="relative">
                            <i class="fa-solid fa-location-dot absolute right-3 top-3.5 text-slate-400"></i>
                            <select id="search-location" class="w-full bg-white text-slate-800 pr-9 pl-3 py-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
                                <option value="">كل المحافظات</option>
                                <option value="المنصورة">المنصورة</option>
                                <option value="القاهرة">القاهرة</option>
                                <option value="الجيزة">الجيزة</option>
                                <option value="الإسكندرية">الإسكندرية</option>
                                <option value="الشرقية">الشرقية</option>
                            </select>
                        </div>
                        <button onclick="filterJobs()" class="bg-teal-500 hover:bg-teal-400 text-slate-900 font-bold px-4 py-2.5 rounded-lg text-sm transition shadow-md shadow-teal-500/30 flex items-center justify-center">
                            <i class="fa-solid fa-filter ml-2"></i>بحث عن الوظائف
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quick Category Badges -->
            <div class="flex items-center space-x-2 space-x-reverse overflow-x-auto pb-2 scrollbar-none text-xs">
                <button onclick="filterCategory('all')" class="cat-btn bg-slate-900 text-white font-bold px-4 py-2 rounded-xl shadow-sm whitespace-nowrap">الكل</button>
                <button onclick="filterCategory('Community')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">🏪 صيدليات مجتمعية</button>
                <button onclick="filterCategory('Hospital')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">🏥 مستشفيات</button>
                <button onclick="filterCategory('Clinical')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">🔬 صيدلة إكلينيكية</button>
                <button onclick="filterCategory('Medical Rep')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">💼 دعاية طبية (Medical Rep)</button>
                <button onclick="filterCategory('Industry')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">🧪 مصانع وشركات أدوية</button>
                <button onclick="filterCategory('Remote')" class="cat-btn bg-white hover:bg-slate-100 border text-slate-700 px-4 py-2 rounded-xl whitespace-nowrap">💻 وظائف عن بُعد</button>
            </div>

            <!-- Job Feed & Details Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Job List -->
                <div class="lg:col-span-2 space-y-4" id="job-list-container">
                    <!-- Dynamic Job Cards Generated Here -->
                </div>

                <!-- Career Path Highlight Sidebar -->
                <div class="space-y-4">
                    <div class="bg-gradient-to-br from-teal-500 to-emerald-600 text-slate-900 p-6 rounded-2xl shadow-lg">
                        <span class="bg-slate-900/20 text-slate-900 text-xs font-extrabold px-2.5 py-1 rounded-md uppercase">بوصلة الصيدلي</span>
                        <h3 class="text-xl font-bold mt-2">لا تعرف أي مسار تختار؟</h3>
                        <p class="text-xs text-slate-900/80 mt-1 mb-4 leading-relaxed">استكشف المهارات المحددة والشهادات المطلوبة لكل تخصص صيدلاني لمعرفة متطلبات سوق العمل قبل التقديم.</p>
                        <button onclick="switchTab('paths')" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl text-xs transition shadow-md">
                            استكشف خريطة المسارات المهنية <i class="fa-solid fa-arrow-left mr-1"></i>
                        </button>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                        <h4 class="font-bold text-slate-800 text-sm mb-3">دورات تدريبية موصى بها</h4>
                        <div class="space-y-3 text-xs">
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                                <span class="text-teal-600 font-bold">كورس OTC & Patient Counseling</span>
                                <p class="text-slate-500 text-[11px] mt-0.5">معتمد لإعداد صيادلة الصيدليات المجتمعية.</p>
                            </div>
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                                <span class="text-teal-600 font-bold">أساسيات Pharmacovigilance</span>
                                <p class="text-slate-500 text-[11px] mt-0.5">مدخل ممتاز للمجال الرقابي بشركات الأدوية.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: CAREER PATHS EXPLORER -->
        <div id="tab-paths" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h2 class="text-2xl font-bold text-slate-900 mb-1">المسارات المهنية للصيدلي (Pharmacist Career Paths)</h2>
                <p class="text-slate-500 text-sm">اختر التخصص لمعرفة الخطوات المطلوبة، المهارات الأساسية، الكورسات الموصى بها، والراتب المتوقع.</p>
            </div>

            <!-- Path Tabs -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-2">
                <button onclick="showPathDetail('community')" class="path-btn p-3 bg-white hover:bg-teal-50 border border-slate-200 rounded-xl text-center transition active-path" data-path="community">
                    <i class="fa-solid fa-store text-xl text-teal-600 mb-1 block"></i>
                    <span class="text-xs font-bold text-slate-800">صيدلية مجتمعية</span>
                </button>
                <button onclick="showPathDetail('hospital')" class="path-btn p-3 bg-white hover:bg-teal-50 border border-slate-200 rounded-xl text-center transition" data-path="hospital">
                    <i class="fa-solid fa-hospital text-xl text-teal-600 mb-1 block"></i>
                    <span class="text-xs font-bold text-slate-800">صيدلية مستشفيات</span>
                </button>
                <button onclick="showPathDetail('clinical')" class="path-btn p-3 bg-white hover:bg-teal-50 border border-slate-200 rounded-xl text-center transition" data-path="clinical">
                    <i class="fa-solid fa-stethoscope text-xl text-teal-600 mb-1 block"></i>
                    <span class="text-xs font-bold text-slate-800">صيدلة إكلينيكية</span>
                </button>
                <button onclick="showPathDetail('medrep')" class="path-btn p-3 bg-white hover:bg-teal-50 border border-slate-200 rounded-xl text-center transition" data-path="medrep">
                    <i class="fa-solid fa-briefcase text-xl text-teal-600 mb-1 block"></i>
                    <span class="text-xs font-bold text-slate-800">دعاية طبية (Med Rep)</span>
                </button>
                <button onclick="showPathDetail('remote')" class="path-btn p-3 bg-white hover:bg-teal-50 border border-slate-200 rounded-xl text-center transition" data-path="remote">
                    <i class="fa-solid fa-laptop-code text-xl text-teal-600 mb-1 block"></i>
                    <span class="text-xs font-bold text-slate-800">صيدلة أونلاين / عن بعد</span>
                </button>
            </div>

            <!-- Path Detail Container -->
            <div id="path-detail-container" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                <!-- Dynamic Content via JS -->
            </div>
        </div>

        <!-- TAB 3: CV BUILDER -->
        <div id="tab-cv" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">منشئ السيرة الذاتية للصيادلة (ATS Pharmacy CV)</h2>
                    <p class="text-slate-500 text-sm">أنشئ سيرتك الذاتية بتنسيق متوافق مع أنظمة التوظيف العالمية مخصص للقطاع الطبي.</p>
                </div>
                <button onclick="window.print()" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center">
                    <i class="fa-solid fa-print ml-2"></i>طباعة / حفظ PDF
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- CV Form -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold text-slate-800 text-base border-b pb-2">البيانات الشخصية والمهنية</h3>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">الاسم بالكامل</label>
                            <input type="text" id="cv-name" value="د. شادي أحمد" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">المسمى الوظيفي الحالي</label>
                            <input type="text" id="cv-title" value="صيدلي مجتمعي خبرة" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">البريد الإلكتروني</label>
                            <input type="email" id="cv-email" value="shady@example.com" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">رقم الهاتف / الواتساب</label>
                            <input type="text" id="cv-phone" value="+20 100 000 0000" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">المحافظة / المدينة</label>
                            <input type="text" id="cv-city" value="المنصورة، مصر" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">سنة التخرج والجامعة</label>
                            <input type="text" id="cv-uni" value="جامعة المنصورة - دفعة 2024" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>

                    <h3 class="font-bold text-slate-800 text-base border-b pb-2 pt-2">الملخص والمهارات الصيدلانية</h3>
                    <div class="text-xs space-y-3">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">نبذة عنك (Summary)</label>
                            <textarea id="cv-summary" rows="3" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">صيدلي شغوف ذو خبرة ممتازة في صرف الدواء، التواصل مع المرضى، وإدارة برامج برمجيات الصيدليات. أسعى لتطوير مهاراتي في الصيدلة الإكلينيكية والخدمات الطبية.</textarea>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">البرامج والأنظمة المعروفة (مثل Pharmasoft, Dawaya...)</label>
                            <input type="text" id="cv-software" value="Pharmasoft, Dawaya, MS Office" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">المهارات والاعتمادات (مفصولة بفواصل)</label>
                            <input type="text" id="cv-skills" value="OTC Counseling, Dispensing, Patient Safety, Inventory Management" oninput="updateCV()" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>
                </div>

                <!-- CV Live Preview -->
                <div class="bg-slate-200 p-4 rounded-2xl flex justify-center">
                    <div id="cv-preview-card" class="bg-white w-full max-w-lg p-8 rounded-xl shadow-md border text-slate-800 text-xs space-y-4">
                        <!-- Live Updated Header -->
                        <div class="border-b-2 border-teal-600 pb-4">
                            <h2 id="pv-name" class="text-2xl font-extrabold text-slate-900">د. شادي أحمد</h2>
                            <p id="pv-title" class="text-teal-600 font-bold text-sm">صيدلي مجتمعي خبرة</p>
                            <div class="flex flex-wrap gap-x-3 gap-y-1 text-slate-500 text-[11px] mt-2">
                                <span><i class="fa-solid fa-envelope ml-1"></i><span id="pv-email">shady@example.com</span></span>
                                <span><i class="fa-solid fa-phone ml-1"></i><span id="pv-phone">+20 100 000 0000</span></span>
                                <span><i class="fa-solid fa-location-dot ml-1"></i><span id="pv-city">المنصورة، مصر</span></span>
                            </div>
                        </div>

                        <!-- Summary -->
                        <div>
                            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider text-teal-700 border-b pb-1 mb-1">النبذة المهنية</h4>
                            <p id="pv-summary" class="text-slate-600 leading-relaxed">صيدلي شغوف ذو خبرة ممتازة في صرف الدواء، التواصل مع المرضى، وإدارة برامج برمجيات الصيدليات.</p>
                        </div>

                        <!-- Education -->
                        <div>
                            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider text-teal-700 border-b pb-1 mb-1">المؤهل الأكاديمي</h4>
                            <p id="pv-uni" class="font-bold text-slate-800">جامعة المنصورة - دفعة 2024</p>
                            <p class="text-slate-500 text-[11px]">بكالوريوس العلوم الصيدلية (ترخيص مزاولة المهنة متاح)</p>
                        </div>

                        <!-- Software & Skills -->
                        <div>
                            <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider text-teal-700 border-b pb-1 mb-1">المهارات البرمجية والفنية</h4>
                            <p id="pv-software" class="text-slate-700 font-medium">Pharmasoft, Dawaya, MS Office</p>
                            <div id="pv-skills-tags" class="flex flex-wrap gap-1 mt-2">
                                <!-- Tags generated -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 4: APPLICATIONS TRACKER -->
        <div id="tab-applications" class="tab-content space-y-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h2 class="text-2xl font-bold text-slate-900">متابعة حالة التقديم (Applications Tracker)</h2>
                <p class="text-slate-500 text-sm">تابع ردود الصيدليات والشركات على طلبات التوظيف الخاصة بك لحظة بلحظة.</p>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-right text-xs">
                        <thead class="bg-slate-50 text-slate-700 font-bold border-b">
                            <tr>
                                <th class="p-4">الوظيفة</th>
                                <th class="p-4">الجهة / الشركة</th>
                                <th class="p-4">المحافظة</th>
                                <th class="p-4">تاريخ التقديم</th>
                                <th class="p-4">حالة الطلب</th>
                            </tr>
                        </thead>
                        <tbody id="applications-table-body" class="divide-y divide-slate-100">
                            <!-- Dynamic Applications -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= EMPLOYER VIEW ================= -->

        <!-- TAB EMP 1: DASHBOARD -->
        <div id="tab-emp-dashboard" class="tab-content space-y-6">
            <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg flex justify-between items-center">
                <div>
                    <span class="text-teal-400 text-xs font-bold uppercase">لوحة تحكم صاحب العمل</span>
